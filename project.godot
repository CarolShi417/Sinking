; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SINKING"
run/main_scene="uid://dov0g81akr1ae"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scenes/global scripts/game_state.gd"
FragmentSystem="*res://scenes/global scripts/fragment_system.gd"
SanSystem="*res://scenes/global scripts/san_system.gd"
ExportSettingController="*res://scenes/global scripts/export_setting_controller.gd"
BuildingSystem="*res://scenes/global scripts/building_system.gd"
MapInfoData="*res://scenes/global scripts/map_info_data.gd"
RandomStoneController="*res://scenes/global scripts/random_stone_controller.gd"
HoverController="*res://scenes/global scripts/HoverController.gd"
TimeCirclingSystem="*res://scenes/global scripts/time_circling_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=240
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/no_focus=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-inspector-lock-main/plugin.cfg")

[file_customization]

folder_colors={
"res://Tilesets/": "yellow",
"res://assets/UI/": "yellow",
"res://assets/UI/美术没画程序就从这里面拿/": "blue",
"res://assets/sprites/": "orange",
"res://audio/": "pink",
"res://scenes/": "green",
"res://scenes/Template/": "purple",
"res://scenes/global scripts/": "purple",
"res://scenes/state_machine/": "purple"
}

[global_group]

TestButton=""
maps=""
WorkerResting=""
WorkerWorking=""
UpgradeBuildingButtonGroup=""
BehaviorController=""
MapSelect=""
StoneComponent=""

[rendering]

textures/canvas_textures/default_texture_filter=3
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.3019608, 0.3019608, 0.3019608, 0)
viewport/transparent_background=true
